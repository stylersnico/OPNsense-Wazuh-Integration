<!--
  OPNsense rules (logs received by syslog on the manager), IDs 100600-100619.
-->

<group name="opnsense,">

  <rule id="100600" level="0">
    <if_sid>6100</if_sid>
    <match type="pcre2">(?:Web GUI authentication error for|Successful login for user) '</match>
    <description>OPNsense: web GUI login messages.</description>
  </rule>

  <rule id="100601" level="5">
    <if_sid>100600</if_sid>
    <match>authentication error for</match>
    <description>OPNsense: web GUI login failed for '$(dstuser)' from $(srcip).</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100602" level="3">
    <if_sid>100600</if_sid>
    <match>Successful login for user</match>
    <description>OPNsense: web GUI login of '$(dstuser)' from $(srcip).</description>
    <group>authentication_success,</group>
  </rule>

  <rule id="100603" level="10" frequency="5" timeframe="300">
    <if_matched_sid>100601</if_matched_sid>
    <same_source_ip />
    <description>OPNsense: web GUI brute force from $(srcip) (5 failed logins in 5 minutes).</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,</group>
  </rule>

</group>

<!--
  Ruleset rule 87702 (18 blocked packets in 45 s from one source) is level 10,
  which mails every internet scanner hitting the WAN. Kept visible on the
  dashboard at level 6, without mail. Same content as the original otherwise.
-->
<group name="pfsense,">

  <rule id="87702" level="6" frequency="18" timeframe="45" ignore="240" overwrite="yes">
    <if_matched_sid>87701</if_matched_sid>
    <same_source_ip />
    <description>Multiple pfSense firewall blocks events from same source.</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>multiple_blocks,pci_dss_1.4,pci_dss_10.6.1,gpg13_4.12,hipaa_164.312.a.1,hipaa_164.312.b,nist_800_53_SC.7,nist_800_53_AU.6,tsc_CC6.7,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

</group>
